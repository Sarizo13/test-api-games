# Configuration d'Asobi. Copier en .env (jamais versionné, droits 600) puis remplir.
# Aucune de ces valeurs n'est envoyée au navigateur.

# Adresse publique du site : sert aux redirections Discord / Steam et active les cookies « Secure »
PUBLIC_URL=https://asobi.sarizo.fr

# Discord (connexion + découverte des comptes) — https://discord.com/developers/applications
# OAuth2 → Redirects : https://asobi.sarizo.fr/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# IGDB (fiches des jeux), via une application Twitch — https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Steam (import de bibliothèque, temps de jeu, succès) — https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Connecteurs NON OFFICIELS (facultatifs, voir GAMING_INTEGRATIONS.md) — identifiants du propriétaire du serveur,
# qui servent seulement à lire les données PUBLIQUES des joueurs (comptes vérifiés par Discord).
# PlayStation : jeton NPSSO (connecté sur playstation.com, ouvrir https://ca.account.sony.com/api/v1/ssocookie), ≈ 2 mois
PSN_NPSSO=
# Xbox : clé du service OpenXBL — https://xbl.io
OPENXBL_API_KEY=
# Epic et Nintendo : rien à configurer (chaque joueur relie son compte en collant un code)

# Facultatifs : visuels SteamGridDB, traduction DeepL des résumés introuvables en français
SGDB_API_KEY=
DEEPL_API_KEY=

# Clé de chiffrement des jetons des plateformes (32 octets en base64, ex. `openssl rand -base64 32`).
# Vide : une clé est générée au premier démarrage dans DATA_DIR/secret.key (à sauvegarder avec la base).
ENCRYPTION_KEY=

# Réglages avancés (valeurs par défaut)
# SESSION_DAYS=30        durée d'une session
# AUTO_SYNC_HOURS=12     synchronisation automatique des comptes de jeu
# BACKUP_KEEP_DAYS=14    sauvegardes quotidiennes gardées dans DATA_DIR/backups
# TRUST_PROXY=1          derrière nginx (X-Real-IP) ; 0 si le serveur est exposé directement
